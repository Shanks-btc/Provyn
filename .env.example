# Solana RPC — use a dedicated provider (Helius here). The public api.mainnet-beta.solana.com endpoint
# rate-limits (HTTP 429) and times out under real use: it is what made market.loadReserves() fail.
# NEVER commit the real key: put it only in .env (gitignored), never in this example file.
# Kamino's SDK is read-heavy; a rate-limited public RPC WILL choke on
# market.loadReserves(). Use a dedicated provider (Helius, Triton, QuickNode) for anything
# beyond a first smoke test.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Kamino xStocks lending market address — VERIFIED LIVE against mainnet on 2026-09-22
# via `npm run check:market`: this market holds 10 xStock reserves (AAPLx, TSLAx, SPYx,
# QQQx, NVDAx, GOOGLx, HOODx, MSTRx, METAx, CRCLx) plus stablecoin reserves for borrowing.
# xStocks live in their OWN dedicated "xStocks Market" (Kamino v2), NOT in Kamino's
# classic Main market — this is a separate isolated market. Re-verify if Kamino adds/
# migrates markets; markets do get added/deprecated.
KAMINO_MAIN_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua

# Path to a local keypair JSON for signing (devnet/test wallet only while iterating —
# never commit a real key, never point this at a funded mainnet wallet during development).
WALLET_KEYPAIR_PATH=./keypair.json

# Anthropic API key for the agent's reasoning/tool-calling loop.
ANTHROPIC_API_KEY=

# Pyth Hermes endpoint. Metadata (/v2/price_feeds) is public, but as of Pyth's Core
# upgrade on 2026-08-26, price-update reads (/v2/updates/price/latest) require an API
# key — VERIFIED LIVE 2026-09-22 (confirmed 401 on a plain BTC/USD request with no key).
# Get one via Pyth Terminal (https://pyth-network.appspot.com/) and set it below.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

# Finnhub is OPT-IN and OFF by default. Its free plan is personal-use only and its terms bar sharing its data or "derived
# results" with third parties without written approval, so nothing public or business-facing may depend on it. With
# FINNHUB_ENABLED unset or not "true": the agent's price check is Pyth only (then a disclosed "unavailable"), the Trade page
# shows no live-price band, and the risk-data collector records only on-chain series and never calls Finnhub.
# Set it to true only on a machine where you hold a licence that permits that use.
FINNHUB_ENABLED=false
# Used only when FINNHUB_ENABLED=true (free tier: 60 calls/min).
FINNHUB_API_KEY=

# Risk dataset (npm run collect). Append-only JSONL, one file per series per UTC day under this directory.
# On a server, point this at a persistent volume and back the directory up (it is plain files: cp / rsync / any object store).
RISKDATA_DIR=./data/riskdata
# Gap statistics derive from Finnhub, so they are exposed (status endpoint, /data page, export) only when FINNHUB_ENABLED AND
# this flag are BOTH true. Leave it false until written approval from Finnhub exists.
RISKDATA_PUBLISH_GAP_STATS=false
