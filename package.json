{
  "name": "provyn",
  "version": "0.1.0",
  "description": "Onchain prime brokerage for xStocks — intent-driven agent for earn/borrow against tokenized equities on Solana, built on Kamino Lend + Pyth.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:agent": "tsx src/agent/cli.ts",
    "check:market": "tsx src/kamino/inspect-market.ts",
    "check:multiply": "tsx src/kamino/inspect-multiply.ts",
    "check:execute": "tsx src/kamino/inspect-execute.ts",
    "check:yield": "tsx src/kamino/inspect-yield.ts",
    "check:multiply-deposit": "tsx src/kamino/inspect-multiply-deposit.ts",
    "check:feeds": "tsx src/pyth/inspect-feeds.ts",
    "check:agent": "tsx src/agent/run-e2e.ts",
    "check:price": "tsx src/inspect-price.ts",
    "collect": "tsx src/riskdata/collect.ts",
    "check:riskdata": "tsx src/riskdata/inspect-riskdata.ts",
    "check:send-devnet": "tsx src/kamino/inspect-send-devnet.ts",
    "snapshot:landing": "tsx scripts/snapshot-landing-figures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@kamino-finance/klend-sdk": "^7.3.20",
    "@solana/web3.js": "^1.95.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@kamino-finance/farms-sdk": "3.2.24"
  }
}
